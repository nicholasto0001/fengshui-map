.DS_Store
__pycache__/
*.pyc
.claude/*
# ……但 skill 係項目嘅一部分，唔係本機設定：冇咗佢 /weekly-post 就唔存在。
# 注意係 `.claude/*` 唔係 `.claude/`：git 唔會行入一個已經 exclude 咗嘅
# 資料夾，所以 exclude 咗成個資料夾之後，下面啲 ! 係一句都唔會生效。
!.claude/skills/

# 人口普查（主要屋苑），逐次由 CSDI 攞返嚟。連 polygon 有 7 MB，
# 同其餘 pipeline 數據一樣唔入 git。
data/census.json

# Generated by the pipeline — rebuilt daily in CI, never committed.
# Committing them would add a fresh 48 MB blob to history every single day.
data/buildings.json
data/scores.json
data/op.json

# data/tiles/ IS tracked: it is what the site actually serves. CI regenerates
# it daily and deploys straight to Pages without committing, so history only
# grows when we refresh it deliberately.
version.json
public/

# Generated by the pipeline and deployed straight to Cloudflare.
data/tiles/
data/search.json
data/district_stats.json
data/elements.json

data/bd_age.json

# Downloaded and generated by the pipeline on every deploy, like the rest.
data/housing.json
data/estates.json

# 航空圖磚快取。地政總署嘅圖，攞返嚟畫屋苑平面圖用，唔入 git。
.tilecache/

# 天文台曆法數據，淨係驗證嗰陣用，bazi/fetch_hko.py 攞得返。
bazi/.hko/

# 本機測試用：等 dev server 揾到 /plan/ 啲圖（build.sh 會真係 copy 過去 public/）
/plan
